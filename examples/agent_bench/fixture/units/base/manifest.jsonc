{
  "$schema": "./manifest.schema.json",
  "name": "@acme/base",
  "version": "1.0.0",
  "description": "Minimal project base: README, .gitignore and package.json.",
  "params": {
    "projectName": {
      "type": "string",
      "description": "The project name, used in package.json and the README.",
      "example": "my-app"
    }
  }
}
