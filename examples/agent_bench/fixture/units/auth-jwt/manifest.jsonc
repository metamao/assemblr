{
  "$schema": "./manifest.schema.json",
  "name": "@acme/auth-jwt",
  "version": "1.0.0",
  "description": "JWT authentication middleware for Cloudflare Workers.",
  "dependencies": {
    "@acme/cloudflare-worker": "^1.0.0"
  },
  "placeholders": {
    "replace": {
      "__JWT_ISSUER__": "The issuer every accepted token must name, such as https://auth.example.com/."
    }
  }
}
